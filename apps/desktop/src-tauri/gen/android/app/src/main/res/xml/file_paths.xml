<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-path name="my_images" path="." />
  <cache-path name="my_cache_images" path="." />
  <!-- Never the files dir root: state/ holds the device identity key. -->
  <files-path name="data" path="data/" />
  <files-path name="config" path="config/" />
  <!-- App update APKs, handed to Android's installer. -->
  <files-path name="updates" path="cache/updates/" />
</paths>
